@page
@model Lab3_Client.Pages.CourseModel

<div>
    <h2>Get course by Id:</h2>
    <form method="post">
        <input type="number" name="courseId" placeholder="Enter course ID" min="0"/>
        <button type="submit">Get Course</button>
    </form>
    <div class="container mt-4">
        <table class="table table-striped table-bordered" style="margin-top:20px">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>StartDate</th>
            <th>TimeSlot</th>
            <th>SubjectCode</th>
        </tr>
        @foreach (var c in Model.Courses)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.CourseName</td>
                <td>@c.StartDate.ToDateTime().ToString("MM/dd/yyyy")</td>
                <td>@c.TimeSlot</td>
                <td>@c.SubjectCode</td>
            </tr>
        }
    </table>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
