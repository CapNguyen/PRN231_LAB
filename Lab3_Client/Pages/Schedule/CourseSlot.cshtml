@page
@model Lab3_Client.Pages.Schedule.CourseSlotModel
@{
}
<div>
    <h2>Get Schedules By Course and Slot:</h2>
    <form method="post">
        <input type="number" name="courseId" placeholder="Enter course ID" min="0" />
        <input type="number" name="slot" placeholder="Enter slot" min="0" />
        <button type="submit">Get Schedules</button>
    </form>
    <div class="container mt-4">
        <table class="table table-striped table-bordered" style="margin-top:20px">
        <tr>
            <th>StudentName</th>
            <th>CourseName</th>
            <th>Slot</th>
            <th>Datetime</th>
            <th>CourseName</th>
            <th>TeacherName</th>
            <th>Status</th>
        </tr>
        @foreach (var a in Model.Attendances)
        {
            <tr>
                <td>@a.StudentName</td>
                <td>@a.CourseName</td>
                <td>@a.Slot</td>
                <td>@a.Datetime.ToDateTime().ToString("MM/dd/yyyy")</td>
                <td>@a.CourseName</td>
                <td>@a.TeacherName</td>
                <td>@a.Status</td>
            </tr>
        }
    </table>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>